rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each device gets its own anonymous account. Progress is private to that account:
    // nobody else can read it, not even the project owner through the app.
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend cards: a small public-ish row (chosen name, streak, XP, whether today is done).
    // Any signed-in user can read one, which is what lets a friend code work; only the
    // owner of the row can write it, and only the fields below.
    match /people/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['streak','last','today','title','xp','nick'])
                   && (!('nick' in request.resource.data) || request.resource.data.nick is string)
                   && (!('nick' in request.resource.data) || request.resource.data.nick.size() <= 30)
                   && (!('xp' in request.resource.data) || request.resource.data.xp is number);
    }

    // In-app feedback. A tester can write and re-read their own feedback document.
    // Nobody can read anyone else's; Seth reads them in the Firebase console.
    match /fb/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
