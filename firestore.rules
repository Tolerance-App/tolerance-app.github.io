rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Seth's stats page (stats.html) signs in like the app. Paste the device ID it shows here,
    // then publish the rules. Only listed IDs can read lesson stats and saved progress.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['WHBKG7KuQRSLpzV30OufPId1VRb2', 'P2jBBhX9biR9oE6z9bZtLtGGnUf2', 'u0izSBG81pVQ2pqO1EGF8RDzB3m2', '2XLhCOa10YY7DrCgB9CyG3a6Awn2'];
    }

    // Each device gets its own anonymous account. Progress is private to that account:
    // nobody else can read it, not even the project owner through the app.
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Friend cards: a small public-ish row (chosen name, streak, XP, whether today is done).
    // Any signed-in user can read one by its ID, which is what lets a friend code work (the app
    // reads friends one document at a time, fbnet.js). Listing the whole collection is only for
    // the stats page (isAdmin). Only the owner of the row can write it, and only the fields below.
    match /people/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['streak','last','today','title','xp','nick'])
                   && (!('nick' in request.resource.data) || request.resource.data.nick is string)
                   && (!('nick' in request.resource.data) || request.resource.data.nick.size() <= 30)
                   && (!('xp' in request.resource.data) || request.resource.data.xp is number);
    }

    // In-app feedback. A tester can write and re-read their own feedback document.
    // Nobody else can read it except the admin flags page (flags.html, isAdmin).
    match /fb/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Flag triage for flags.html: status, category, fixed-in build and a note per flag,
    // keyed "{uid}_{itemId}". Admin devices only.
    match /fbtri/{fid} {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.data.keys().hasOnly(['s','c','fix','note','at','by'])
                   && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
    }

    // Anonymous lesson stats (b34). Any device can add a record about itself; nobody can
    // change or delete one, and only the stats page (isAdmin) can read them.
    match /ev/{eid} {
      allow read: if isAdmin();
      allow create: if request.auth != null
                    && eid.matches(request.auth.uid + '_[a-z0-9]+')
                    && request.resource.data.u == request.auth.uid
                    && request.resource.data.keys().hasOnly(['u','k','id','t','sub','br','lv','n','sc','pass','sec','ok','miss','end','at','v','d','ts'])
                    && request.resource.data.k is string && request.resource.data.k.size() <= 20
                    && (!('id' in request.resource.data) || (request.resource.data.id is string && request.resource.data.id.size() <= 120))
                    && (!('t' in request.resource.data) || (request.resource.data.t is string && request.resource.data.t.size() <= 120))
                    && (!('ok' in request.resource.data) || (request.resource.data.ok is list && request.resource.data.ok.size() <= 40))
                    && (!('miss' in request.resource.data) || (request.resource.data.miss is list && request.resource.data.miss.size() <= 40))
                    && request.resource.data.ts is number;
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
